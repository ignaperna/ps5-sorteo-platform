# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sorteo_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/sorteo_db

# Mercado Pago Checkout Pro
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
WEBHOOK_BASE_URL=https://api.tudominio.com
FRONTEND_URL=https://tudominio.com

# Infoproducto (Link de descarga del eBook/PDF)
EBOOK_PDF_URL=https://tudominio.com/assets/ebook-exclusivo.pdf

# Configuración SMTP para envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tudominio.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="Plataforma eBooks & Sorteo <notificaciones@tudominio.com>"

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
